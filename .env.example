# Sabarimala Slot Alert Environment Variables

# App URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sabarimala API Endpoint Configuration
# Default official endpoint: https://sabarimalaonline.org/api/eDarshan/darshansummary/100001
SABARIMALA_API_URL=https://sabarimalaonline.org/api/eDarshan/darshansummary/100001
SABARIMALA_SERVICE_ID=100001

# Monitoring Mode: 'LIVE' or 'MOCK' (Default is LIVE with automatic fallback if blocked)
NEXT_PUBLIC_DEFAULT_DATA_MODE=LIVE

# Monitoring Interval in milliseconds (default 5 minutes = 300000)
MONITORING_INTERVAL_MS=300000

# Telegram Bot API Configuration
# Get BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get CHAT_ID from @userinfobot or when messaging your bot
TELEGRAM_CHAT_ID=

# Supabase Configuration
# Optional: If not provided, the app uses an in-memory/JSON local database store
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
